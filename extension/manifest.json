{
  "manifest_version": 3,
  "name": "KLU AttendIQ — Attendance Reader",
  "version": "1.3.0",
  "description": "Reads the attendance table visible in KLU ERP and syncs it to KLU AttendIQ.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://newerp.kluniversity.in/*",
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://newerp.kluniversity.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KLU AttendIQ"
  }
}
